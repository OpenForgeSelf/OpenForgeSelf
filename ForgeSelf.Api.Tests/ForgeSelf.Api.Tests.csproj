<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="E2E/**/*.cs" />
    <None Remove="E2E/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeSelf.Api\ForgeSelf.Api.csproj" />
    <!-- MemorySystem/TodoTracker/QuickLinks/TextTools 已拆分为独立程序集（ADR D2），测试直接引用其类型 -->
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\MemorySystem\MemorySystem.csproj" />
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\TodoTracker\TodoTracker.csproj" />
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\QuickLinks\QuickLinks.csproj" />
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\TextTools\TextTools.csproj" />
    <!-- 第二批拆分（FileTools/DevTools/SystemMonitor，ADR D2 续） -->
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\FileTools\FileTools.csproj" />
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\DevTools\DevTools.csproj" />
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\SystemMonitor\SystemMonitor.csproj" />
    <!-- 第三批拆分（Scheduler/ScriptRunner/WorkflowEngine，ADR D2 续） -->
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\Scheduler\Scheduler.csproj" />
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\ScriptRunner\ScriptRunner.csproj" />
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\WorkflowEngine\WorkflowEngine.csproj" />
    <!-- 第四批拆分（AIAgent，ADR D2 续） -->
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\AIAgent\AIAgent.csproj" />
    <!-- 抓包代理插件（ProxyCapture，单测直接引用其 Core 类型） -->
    <!-- sems 插件（spec028 运行管理 RunnerService / 进程归属判定纯函数） -->
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\Sems\Sems.csproj" />
    <!-- ImGateway / AgentHub 插件（ADR D2 续）：单测直接引用其类型（FrameParser/ConfigStore/通道/委派运行时），
         此前漏登记，宿主全量重建后（插件源码不再编入宿主）测试编译失败，2026-09-21 补齐。 -->
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\ImGateway\ImGateway.csproj" />
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\AgentHub\AgentHub.csproj" />
    <!-- McpCenter 插件（034 v2.0.0，前身 McpGateway）：单测直接引用其转发器 / JSON-RPC 处理器 / 服务类型 -->
    <ProjectReference Include="..\ForgeSelf.Api\Plugins\McpCenter\McpCenter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- MCP 中心外部接入集成测试用 mock MCP 服务器（stdio / streamable-http / http-sse 三传输） -->
  <ItemGroup>
    <None Include="Plugins\McpCenterTests\Fixtures\mock-mcp-server.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 测试宿主同步插件 DLL（修复拆独立程序集后 GetExecutionStatus 期望404实得500）：
       Backend 的 Stage* 目标只复制到 Backend 自身输出，不会经 ProjectReference 流入测试输出；
       测试宿主 Plugins/<Name>/ 下仅有 plugin.json（EntryAssembly=<Name>.dll）而缺插件 DLL，
       ResolvePluginInstance 找不到独立 DLL 时回退主程序集，而批3 拆分后插件类型已不在主程序集，
       导致插件加载失败、其 DI 服务（如 WorkflowEngine 的 IWorkflowService）未注册 → GetRequiredService 抛异常 → 500。
       此处从 Backend 输出按相同 Plugins/ 布局同步到测试输出，使测试宿主与真实宿主加载行为一致。 -->
  <Target Name="StagePluginDllsToTestOutput" AfterTargets="Build">
    <ItemGroup>
      <_TestPluginDlls Include="..\ForgeSelf.Api\bin\$(Configuration)\net10.0-windows\Plugins\**\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_TestPluginDlls)"
          DestinationFiles="@(_TestPluginDlls->'$(OutDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>