<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Home</AssemblyName>
    <RootNamespace>ForgeSelf.Api.Plugins.Home</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Microsoft.NET.Sdk（非 Web SDK）不含 ASP.NET Core 隐式 using，补全局 Using -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <!-- Home 是 view-only 全量插件化首页，仅贡献一个侧边栏菜单扩展点，无独立后端服务 -->
  <!-- （首页所需的 workflow/scripts/skills/monitor/todos 数据经宿主既有接口获取，见前端 http.ts） -->

  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="11.17.2026.701" />
    <ProjectReference Include="..\..\..\ForgeSelf.Core\ForgeSelf.Core.csproj" />
    <ProjectReference Include="..\..\..\ForgeSelf.Abstractions\ForgeSelf.Abstractions.csproj" />
  </ItemGroup>

</Project>
