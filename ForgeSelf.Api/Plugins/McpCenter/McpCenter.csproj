<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>McpCenter</AssemblyName>
    <RootNamespace>ForgeSelf.Api.Plugins.McpCenter</RootNamespace>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- 暴露 internal 纯函数（转发器 / JSON-RPC 处理器）给测试工程 -->
  <ItemGroup>
    <InternalsVisibleTo Include="ForgeSelf.Api.Tests" />
  </ItemGroup>

  <!-- 非 Web SDK，无 ASP.NET Core 隐式 using，补全局 Using -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="11.17.2026.701" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ForgeSelf.Core\ForgeSelf.Core.csproj" />
    <ProjectReference Include="..\..\..\ForgeSelf.Abstractions\ForgeSelf.Abstractions.csproj" />
  </ItemGroup>

</Project>
