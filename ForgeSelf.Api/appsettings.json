{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "ApiEndpoint": "mock://local",
    "ApiKey": "",
    "ModelName": "mock",
    "Providers": [
      {
        "Name": "mock",
        "ProviderType": "Mock",
        "Endpoint": "mock://local",
        "ApiKey": "",
        "SupportedModels": ["mock"],
        "IsDefault": true,
        "TimeoutSeconds": 120,
        "EnableMultimodal": true,
        "VisionModel": null,
        "VisionPromptTemplate": "请描述这张图片的内容，包括图中的人物、物体、场景等细节。"
      }
    ]
  },
  "Update": {
    "Provider": "github",
    "GitHubApiUrl": "https://api.github.com",
    "GitHubRepo": "OpenForgeSelf/OpenForgeSelf",
    "ServerUrl": "",
    "Channel": "stable",
    "CheckIntervalMinutes": 60,
    "CheckTimeoutSeconds": 15,
    "DownloadTimeoutSeconds": 600
  },

  "Service": {
    "ServiceName": "ForgeSelf",
    "DisplayName": "ForgeSelf Server",
    "Description": "铸己匣 ForgeSelf 后端服务",
    "AutoStart": true,
    "ShowTrayInServiceMode": false
  },

  "GitHubOAuth": {
    "ClientId": "Ov23likdtDN2AlQvAO33",
    "Scopes": "repo workflow"
  }
