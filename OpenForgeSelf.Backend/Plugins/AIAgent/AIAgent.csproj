<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AIAgent</AssemblyName>
    <RootNamespace>OpenForgeSelf.Backend.Plugins.AIAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Microsoft.NET.Sdk（非 Web SDK）不含 ASP.NET Core 隐式 using，补全局 Using -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <!-- AIAgentDbContext/ChatMessageEntity 是死代码（EF DbContext 未注册），不引 EF Sqlite，排除编译 -->
  <ItemGroup>
    <Compile Remove="Data\AIAgentDbContext.cs" />
    <Compile Remove="Data\ChatMessageEntity.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="11.17.2026.701" />
    <PackageReference Include="NewLife.XCode" Version="12.0.2026.701" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\OpenForgeSelf.Core\OpenForgeSelf.Core.csproj" />
    <ProjectReference Include="..\..\..\OpenForgeSelf.Abstractions\OpenForgeSelf.Abstractions.csproj" />
  </ItemGroup>

</Project>
