<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AgentHub</AssemblyName>
    <RootNamespace>ForgeSelf.Api.Plugins.AgentHub</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- 暴露 internal 纯函数（BuildArgs / ExtractVersion 等）给测试工程：
       验证「prompt 里的 shell 元字符不会被当命令执行」属安全铁证，必须可回归 -->
  <ItemGroup>
    <InternalsVisibleTo Include="ForgeSelf.Api.Tests" />
  </ItemGroup>

  <!-- 非 Web SDK，无 ASP.NET Core 隐式 using，补全局 Using -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Mvc" />
  </ItemGroup>

  <!-- AgentHub 用 XCode 存注册表/任务/事件（连接名 AgentHub），并复用 NewLife.Core 日志 -->
  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="11.17.2026.701" />
    <PackageReference Include="NewLife.XCode" Version="12.0.2026.701" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ForgeSelf.Core\ForgeSelf.Core.csproj" />
    <ProjectReference Include="..\..\ForgeSelf.Abstractions\ForgeSelf.Abstractions.csproj" />
  </ItemGroup>

  <!-- 内置 profile（L1 扩展点）随程序集输出；运行时优先读数据根下 Profiles 覆盖版本 -->
  <ItemGroup>
    <None Update="Data\Profiles\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
