<?xml version="1.0" encoding="utf-8"?>
<EntityModel xmlns:xs="http://www.w3.org/2001/XMLSchema" xs:schemaLocation="https://newlifex.com https://newlifex.com/Model202509.xsd" ModelVersion="2.0.2026.130" Document="https://newlifex.com/xcode/model" xmlns="https://newlifex.com/Model202509.xsd">
  <Option>
    <!--类名模板。其中{name}替换为Table.Name，如{name}Model/I{name}Dto等-->
    <ClassNameTemplate>{name}</ClassNameTemplate>
    <!--显示名模板。其中{displayName}替换为Table.DisplayName-->
    <DisplayNameTemplate>{name}</DisplayNameTemplate>
    <!--基类。可能包含基类和接口，其中{name}替换为Table.Name-->
    <BaseClass>Entity</BaseClass>
    <!--命名空间-->
    <Namespace>ForgeSelf.Api.Plugins.DbAdmin.Entities</Namespace>
    <!--引用命名空间-->
    <ExtendNameSpace />
    <!--输出目录-->
    <Output>Entities</Output>
    <!--是否使用中文文件名。默认false-->
    <ChineseFileName>False</ChineseFileName>
    <!--用于生成Copy函数的参数类型。例如{name}或I{name}-->
    <ModelNameForCopy />
    <!--带有索引器。实现IModel接口-->
    <HasIModel>False</HasIModel>
    <!--可为null上下文。生成String?等-->
    <Nullable>False</Nullable>
    <!--数据库连接名-->
    <ConnName>DbAdmin</ConnName>
    <!--模型类模版。设置后生成模型类，用于接口数据传输，例如{name}Model-->
    <ModelClass />
    <!--模型类输出目录。默认当前目录的Models子目录-->
    <ModelsOutput>.\Models\</ModelsOutput>
    <!--模型接口模版。设置后生成模型接口，用于约束模型类和实体类，例如I{name}-->
    <ModelInterface />
    <!--模型接口输出目录。默认当前目录的Interfaces子目录-->
    <InterfacesOutput>.\Interfaces\</InterfacesOutput>
    <!--用户实体转为模型类的模型类。例如{name}或{name}DTO-->
    <ModelNameForToModel />
    <!--命名格式。Default/Upper/Lower/Underline-->
    <NameFormat>Default</NameFormat>
    <!--魔方区域显示名-->
    <DisplayName />
    <!--魔方控制器输出目录-->
    <CubeOutput />
  </Option>
  <Tables>
    <Table Name="DbConnection" Description="用户数据库连接配置（密码/连接串加密存储）">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="连接ID" />
        <Column Name="Name" DataType="String" Master="True" Length="100" Nullable="False" Description="连接名（唯一）" />
        <Column Name="Provider" DataType="String" Nullable="False" Description="数据库类型 sqlite/mysql/postgresql/sqlserver" />
        <Column Name="Mode" DataType="String" Length="20" Nullable="False" DefaultValue="form" Description="配置方式 form/connstr" />
        <Column Name="Host" DataType="String" Length="200" Description="主机（SQLite 为文件路径时放 Database）" />
        <Column Name="Port" DataType="Int32" Description="端口" />
        <Column Name="Database" DataType="String" Length="500" Description="数据库名或 SQLite 文件路径" />
        <Column Name="UserName" DataType="String" Length="100" Description="用户名" />
        <Column Name="PasswordEnc" DataType="String" Length="1000" Description="加密后的密码" />
        <Column Name="ConnStrEnc" DataType="String" Length="4000" Description="加密后的原始连接串（Mode=connstr）" />
        <Column Name="Readonly" DataType="Boolean" Description="用户自设只读" />
        <Column Name="CreateTime" DataType="DateTime" Description="创建时间" />
        <Column Name="UpdateTime" DataType="DateTime" Description="更新时间" />
      </Columns>
      <Indexes>
        <Index Columns="Name" Unique="True" />
      </Indexes>
    </Table>
    <Table Name="DbQueryHistory" Description="SQL 执行历史（仅存脱敏 SQL）">
      <Columns>
        <Column Name="Id" DataType="Int64" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="ConnectionId" DataType="String" Length="100" Description="连接标识（用户连接为数字Id，系统连接为 sys:连接名）" />
        <Column Name="SqlRedacted" DataType="String" Master="True" Length="8000" Description="脱敏后的 SQL" />
        <Column Name="Kind" DataType="String" Length="20" Description="read/write" />
        <Column Name="RowCount" DataType="Int64" Description="返回或影响行数" />
        <Column Name="ElapsedMs" DataType="Int64" Description="耗时毫秒" />
        <Column Name="Success" DataType="Boolean" Description="是否成功" />
        <Column Name="Error" DataType="String" Length="2000" Description="错误（脱敏）" />
        <Column Name="Source" DataType="String" Length="20" Description="ui/agent" />
        <Column Name="CreateTime" DataType="DateTime" Description="时间" />
      </Columns>
      <Indexes>
        <Index Columns="CreateTime" />
        <Index Columns="ConnectionId" />
      </Indexes>
    </Table>
    <Table Name="DbApproval" Description="写操作审批（原始 SQL 仅内存持有）">
      <Columns>
        <Column Name="Id" DataType="Int64" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="ConnectionId" DataType="String" Length="100" Description="连接标识" />
        <Column Name="SqlRedacted" DataType="String" Master="True" Length="8000" Description="脱敏后的 SQL" />
        <Column Name="Kind" DataType="String" Length="20" Description="write/destructive" />
        <Column Name="Destructive" DataType="Boolean" Description="是否破坏性（需二次确认）" />
        <Column Name="Status" DataType="String" Length="20" Nullable="False" DefaultValue="pending" Description="pending/approved/rejected/expired" />
        <Column Name="Source" DataType="String" Length="20" Description="ui/agent" />
        <Column Name="CreateTime" DataType="DateTime" Description="创建时间" />
        <Column Name="ResolveTime" DataType="DateTime" Description="处理时间" />
      </Columns>
      <Indexes>
        <Index Columns="Status" />
        <Index Columns="CreateTime" />
      </Indexes>
    </Table>
    <Table Name="DbAuditLog" Description="审计日志（脱敏）">
      <Columns>
        <Column Name="Id" DataType="Int64" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="Kind" DataType="String" Description="conn_create/conn_update/conn_delete/conn_test/query/classify/approval_*/write_result/rejected/permission_mode" />
        <Column Name="ConnectionId" DataType="String" Length="100" Description="连接标识" />
        <Column Name="SqlRedacted" DataType="String" Length="8000" Description="脱敏后的 SQL" />
        <Column Name="Decision" DataType="String" Description="决策 allow/ask/reject/approved 等" />
        <Column Name="Detail" DataType="String" Master="True" Length="2000" Description="详情（脱敏）" />
        <Column Name="Source" DataType="String" Description="来源 ui/agent" />
        <Column Name="SessionId" DataType="String" Length="100" Description="Agent 会话标识（仅 agent）" />
        <Column Name="Status" DataType="String" Description="结果状态 ok/awaiting_approval/rejected/error（kind=agent 摘要用）" />
        <Column Name="Code" DataType="String" Description="错误码（kind=agent 摘要用）" />
        <Column Name="SqlKind" DataType="String" Description="语句类别 read/write（kind=agent 摘要用）" />
        <Column Name="RowCount" DataType="Int64" Description="返回行数或影响行数" />
        <Column Name="Truncated" DataType="Boolean" Description="结果是否被 Agent 上限截断" />
        <Column Name="ApprovalId" DataType="Int64" Description="关联审批编号" />
        <Column Name="CreateTime" DataType="DateTime" Description="时间" />
      </Columns>
      <Indexes>
        <Index Columns="CreateTime" />
        <Index Columns="Kind" />
      </Indexes>
    </Table>
  </Tables>
</EntityModel>