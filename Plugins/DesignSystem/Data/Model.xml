        <Column Name="ColorHex" DataType="String" Length="20" Description="解析后 sRGB hex，供对比度数学与外部 lint" />
        <Column Name="OklchL" DataType="Double" Description="OKLCH 明度 L（拆列以便 SQL 插值/检索）" />
        <Column Name="OklchC" DataType="Double" Description="OKLCH 彩度 C" />
        <Column Name="OklchH" DataType="Double" Description="OKLCH 色相 H" />
        <Column Name="Alpha" DataType="Double" DefaultValue="1" Description="透明度 0~1" />
        <Column Name="ColorSpace" DataType="String" Length="20" DefaultValue="oklch" Description="色彩空间：oklch|srgb|display-p3" />
        <Column Name="IsPrimary" DataType="Boolean" DefaultValue="0" Description="是否该族主色" />
        <Column Name="ContrastOn" DataType="String" Length="200" Description="对比度计算所对的前景/背景配对路径" />
        <Column Name="ContrastRatio" DataType="Double" Description="WCAG 2.2 对比度比率，未计算为 -1" />
        <Column Name="WcagLevel" DataType="String" Length="10" Description="达标等级：none|aa|aaa" />
        <Column Name="ApcaLc" DataType="Double" Description="APCA Lc 参考读数（不作门禁，仅参考）" />
        <Column Name="Generator" DataType="String" DefaultValue="manual" Description="来源：oklch-ramp|manual|imported|derived" />
        <Column Name="GeneratorSeed" DataType="String" Length="100" Description="生成种子（同输入可复现）" />
        <Column Name="GeneratorVersion" DataType="String" Length="20" Description="生成器版本" />
        <Column Name="Lifecycle" DataType="String" Length="20" DefaultValue="adopted" Description="治理生命周期：proposed|adopted|deprecated|removed" />
        <Column Name="ReplacedBy" DataType="String" Length="200" Description="废弃后替代令牌路径" />
        <Column Name="Deprecated" DataType="Boolean" DefaultValue="0" Description="是否已废弃" />
        <Column Name="Tags" DataType="String" Length="300" Description="标签，逗号分隔，供检索" />
        <Column Name="SortOrder" DataType="Int32" Description="排序" />
        <Column Name="Extensions" DataType="String" Length="2000" Description="DTCG $extensions 与厂商元数据（JSON）" />
        <Column Name="CreatedAt" DataType="DateTime" Description="创建时间" />
        <Column Name="UpdatedAt" DataType="DateTime" Description="更新时间，兼作乐观并发依据" />
      </Columns>
      <Indexes>
        <Index Columns="ProjectId,ThemeId,Path" Unique="True" />
        <Index Columns="ProjectId,Tier" />
        <Index Columns="ProjectId,Group" />
        <Index Columns="ProjectId,AliasPath" />
        <Index Columns="OklchH" />
      </Indexes>
    </Table>
