    <Table Name="DesignToken" Description="设计令牌">
      <Columns>
        <Column Name="Id" DataType="Int64" Identity="True" PrimaryKey="True" Description="令牌ID" />
        <Column Name="ProjectId" DataType="Int64" Description="项目ID" />
