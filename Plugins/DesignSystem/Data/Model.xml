        <Column Name="Type" DataType="String" Length="30" DefaultValue="color" Description="DTCG $type：color|dimension|fontFamily|fontWeight|duration|cubicBezier|number|string|shadow|border|gradient|typography|transition|strokeStyle" />
        <Column Name="Value" DataType="String" Length="500" Description="解析后的最终值（hex/oklch()/px 等字符串形态）" />
        <Column Name="ValueJson" DataType="String" Length="4000" Description="结构化/复合值（JSON）。复合令牌以此为真源" />
        <Column Name="AliasPath" DataType="String" Length="200" Description="别名指向的令牌路径，禁止环与逆向引用" />
        <Column Name="Group" DataType="String" Length="100" Description="分组（导出层级用），如 brand/spacing/shadow" />
