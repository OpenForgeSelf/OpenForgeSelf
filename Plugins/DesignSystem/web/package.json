{
  "name": "forgeself-plugin-designsystem-web",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "设计系统插件自带界面（库驱动工作台）：构建为 ESM，由宿主运行时远程加载",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "check": "pnpm -C ../../../ForgeSelf.Web exec vue-tsc --noEmit -p ../Plugins/DesignSystem/web/tsconfig.check.json",
    "test": "pnpm -C ../../../ForgeSelf.Web exec vitest run ../Plugins/DesignSystem/web/src"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
