<?xml version="1.0" encoding="utf-8"?>
<EntityModel xmlns:xs="http://www.w3.org/2001/XMLSchema" xs:schemaLocation="https://newlifex.com https://newlifex.com/Model202509.xsd" ModelVersion="2.0.2026.130" Document="https://newlifex.com/xcode/model" xmlns="https://newlifex.com/Model202509.xsd">
  <Option>
    <!--类名模板。其中{name}替换为Table.Name，如{name}Model/I{name}Dto等-->
    <ClassNameTemplate>{name}</ClassNameTemplate>
    <!--显示名模板。其中{displayName}替换为Table.DisplayName-->
    <DisplayNameTemplate>{name}</DisplayNameTemplate>
    <!--基类。可能包含基类和接口，其中{name}替换为Table.Name-->
    <BaseClass>Entity</BaseClass>
    <!--命名空间-->
    <Namespace>ForgeSelf.Api.Plugins.FileTools.Entities</Namespace>
    <!--引用命名空间-->
    <ExtendNameSpace />
    <!--输出目录-->
    <Output>Entities</Output>
    <!--是否使用中文文件名。默认false-->
    <ChineseFileName>False</ChineseFileName>
    <!--用于生成Copy函数的参数类型。例如{name}或I{name}-->
    <ModelNameForCopy />
    <!--带有索引器。实现IModel接口-->
    <HasIModel>False</HasIModel>
    <!--可为null上下文。生成String?等-->
    <Nullable>False</Nullable>
    <!--数据库连接名-->
    <ConnName>FileTools</ConnName>
    <!--模型类模版。设置后生成模型类，用于接口数据传输，例如{name}Model-->
    <ModelClass />
    <!--模型类输出目录。默认当前目录的Models子目录-->
    <ModelsOutput>.\Models\</ModelsOutput>
    <!--模型接口模版。设置后生成模型接口，用于约束模型类和实体类，例如I{name}-->
    <ModelInterface />
    <!--模型接口输出目录。默认当前目录的Interfaces子目录-->
    <InterfacesOutput>.\Interfaces\</InterfacesOutput>
    <!--用户实体转为模型类的模型类。例如{name}或{name}DTO-->
    <ModelNameForToModel />
    <!--命名格式。Default/Upper/Lower/Underline-->
    <NameFormat>Default</NameFormat>
    <!--魔方区域显示名-->
    <DisplayName />
    <!--魔方控制器输出目录-->
    <CubeOutput />
  </Option>
  <Tables>
    <Table Name="ScanSnapshot" Description="目录大小扫描快照">
      <Columns>
        <Column Name="Id" DataType="Int64" Identity="True" PrimaryKey="True" Description="快照ID" />
        <Column Name="RootPath" DataType="String" Master="True" Length="1000" Nullable="False" Description="扫描根路径" />
        <Column Name="ScannedAt" DataType="DateTime" Description="扫描完成时间" />
        <Column Name="DurationMs" DataType="Int64" Description="扫描耗时毫秒" />
        <Column Name="RootTotalBytes" DataType="Int64" Description="根目录总字节（含全部后代）" />
        <Column Name="RootOwnBytes" DataType="Int64" Description="根目录本级文件字节（不属于任何子目录）" />
        <Column Name="DirectoryCount" DataType="Int64" Description="计入目录数" />
        <Column Name="ChildCount" DataType="Int64" Description="已知直接子目录总数（用于还原被 Top 挤掉的其他行）" />
        <Column Name="FileCount" DataType="Int64" Description="计入文件数" />
        <Column Name="Top" DataType="Int32" Description="保存的排行条数" />
        <Column Name="Truncated" DataType="Boolean" Description="是否因条目上限被截断" />
        <Column Name="InaccessibleCount" DataType="Int64" Description="无权限条目数" />
        <Column Name="SkippedReparseCount" DataType="Int64" Description="跳过的重解析点数" />
        <Column Name="Note" DataType="String" Length="200" Description="备注" />
      </Columns>
      <Indexes>
        <Index Columns="ScannedAt" />
        <Index Columns="RootPath" />
      </Indexes>
    </Table>
    <Table Name="ScanFolderEntry" Description="目录大小排行明细行（属于某次快照）">
      <Columns>
        <Column Name="Id" DataType="Int64" Identity="True" PrimaryKey="True" Description="行ID" />
        <Column Name="SnapshotId" DataType="Int64" Description="快照ID" />
        <Column Name="RelativePath" DataType="String" Master="True" Length="1000" Nullable="False" Description="相对根的目录路径，/分隔" />
        <Column Name="Name" DataType="String" Length="260" Description="目录名" />
        <Column Name="TotalBytes" DataType="Int64" Description="含全部后代的字节数" />
        <Column Name="DirectBytes" DataType="Int64" Description="本级直接字节数" />
        <Column Name="FileCount" DataType="Int64" Description="本级文件数" />
        <Column Name="DirCount" DataType="Int64" Description="本级子目录数" />
      </Columns>
      <Indexes>
        <Index Columns="SnapshotId" />
        <Index Columns="SnapshotId,TotalBytes" />
      </Indexes>
    </Table>
  </Tables>
</EntityModel>