<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ImGateway</AssemblyName>
    <RootNamespace>ForgeSelf.Api.Plugins.ImGateway</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测试缝：单测直接访问 internal 成员（与 AIAgent 同款，T16 NowProvider 假时钟等） -->
    <InternalsVisibleTo Include="ForgeSelf.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- 非 Web SDK，无 ASP.NET Core 隐式 using，补全局 Using -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Mvc" />
  </ItemGroup>

  <!-- ImGateway 仅用 NewLife.Log(XTrace) 日志，不依赖 XCode ORM -->
  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="11.17.2026.701" />
    <PackageReference Include="NewLife.XCode" Version="12.0.2026.701" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ForgeSelf.Core\ForgeSelf.Core.csproj" />
    <ProjectReference Include="..\..\ForgeSelf.Abstractions\ForgeSelf.Abstractions.csproj" />
  </ItemGroup>

</Project>
