<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>McpCenter</AssemblyName>
    <RootNamespace>ForgeSelf.Api.Plugins.McpCenter</RootNamespace>
    <Version>2.3.0</Version>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- 暴露 internal 纯函数（转发器 / JSON-RPC 处理器）给测试工程 -->
  <ItemGroup>
    <InternalsVisibleTo Include="ForgeSelf.Api.Tests" />
  </ItemGroup>

  <!-- 非 Web SDK，无 ASP.NET Core 隐式 using，补全局 Using -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="11.17.2026.701" />
    <!-- 官方 MCP C# SDK（微软 + Anthropic 共同维护）：托管 Streamable HTTP 传输与协议协商，
         替代自研 McpJsonRpcHandler 的传输层职责；有状态模式由网关显式开启（Stateless=false）。 -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ForgeSelf.Core\ForgeSelf.Core.csproj" />
    <ProjectReference Include="..\..\ForgeSelf.Abstractions\ForgeSelf.Abstractions.csproj" />
  </ItemGroup>

</Project>
