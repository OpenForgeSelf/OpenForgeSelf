{
  "name": "forgeself-plugin-mcpcenter-web",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "MCP 中心插件自带界面（构建为 ESM，由宿主运行时远程加载）",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "check": "pnpm -C ../../../ForgeSelf.Web exec vue-tsc --noEmit -p ../Plugins/McpCenter/web/tsconfig.check.json",
    "test": "pnpm -C ../../../ForgeSelf.Web exec vitest run ../Plugins/McpCenter/web/src"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "element-plus": "^2.14.5",
    "tailwindcss": "^4.3.3",
    "vite": "^6.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
