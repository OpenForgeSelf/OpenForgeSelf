<?xml version="1.0" encoding="utf-8"?>
<EntityModel xmlns:xs="http://www.w3.org/2001/XMLSchema" xs:schemaLocation="https://newlifex.com https://newlifex.com/Model202509.xsd" ModelVersion="2.0.2026.130" Document="https://newlifex.com/xcode/model" xmlns="https://newlifex.com/Model202509.xsd">
  <Option>
    <!--类名模板。其中{name}替换为Table.Name，如{name}Model/I{name}Dto等-->
    <ClassNameTemplate>{name}</ClassNameTemplate>
    <!--显示名模板。其中{displayName}替换为Table.DisplayName-->
    <DisplayNameTemplate>{name}</DisplayNameTemplate>
    <!--基类。可能包含基类和接口，其中{name}替换为Table.Name-->
    <BaseClass>Entity</BaseClass>
    <!--命名空间-->
    <Namespace>ForgeSelf.Api.Plugins.MemorySystem.Entities</Namespace>
    <!--引用命名空间-->
    <ExtendNameSpace />
    <!--输出目录-->
    <Output>Entities</Output>
    <!--是否使用中文文件名。默认false-->
    <ChineseFileName>False</ChineseFileName>
    <!--用于生成Copy函数的参数类型。例如{name}或I{name}-->
    <ModelNameForCopy />
    <!--带有索引器。实现IModel接口-->
    <HasIModel>False</HasIModel>
    <!--可为null上下文。生成String?等-->
    <Nullable>False</Nullable>
    <!--数据库连接名-->
    <ConnName>MemorySystem</ConnName>
    <!--模型类模版。设置后生成模型类，用于接口数据传输，例如{name}Model-->
    <ModelClass />
    <!--模型类输出目录。默认当前目录的Models子目录-->
    <ModelsOutput>.\Models\</ModelsOutput>
    <!--模型接口模版。设置后生成模型接口，用于约束模型类和实体类，例如I{name}-->
    <ModelInterface />
    <!--模型接口输出目录。默认当前目录的Interfaces子目录-->
    <InterfacesOutput>.\Interfaces\</InterfacesOutput>
    <!--用户实体转为模型类的模型类。例如{name}或{name}DTO-->
    <ModelNameForToModel />
    <!--命名格式。Default/Upper/Lower/Underline-->
    <NameFormat>Default</NameFormat>
    <!--魔方区域显示名-->
    <DisplayName />
    <!--魔方控制器输出目录-->
    <CubeOutput />
  </Option>
  <Tables>
    <Table Name="Memory" Description="记忆">
      <Columns>
        <Column Name="Id" DataType="Int64" Identity="True" PrimaryKey="True" Description="记忆ID" />
        <Column Name="Title" DataType="String" Master="True" Length="500" Nullable="False" Description="标题" />
        <Column Name="Content" DataType="String" Length="4000" Nullable="False" Description="内容" />
        <Column Name="Type" DataType="Int32" Description="类型（0事实 1偏好 2项目 3个人 4工作流 5技能 99其他）" />
        <Column Name="Importance" DataType="Int32" Description="重要度（0低 1中 2高 3关键）" />
        <Column Name="Tags" DataType="String" Length="200" Description="标签" />
        <Column Name="Source" DataType="String" Length="500" Description="来源" />
        <Column Name="CategoryId" DataType="Int64" Description="分类ID" />
        <Column Name="AccessCount" DataType="Int32" Description="访问次数" />
        <Column Name="LastAccessedAt" DataType="DateTime" Description="最后访问时间" />
        <Column Name="DecayScore" DataType="Double" Description="衰减分数" />
        <Column Name="CreatedAt" DataType="DateTime" Description="创建时间" />
        <Column Name="UpdatedAt" DataType="DateTime" Description="更新时间" />
        <Column Name="IsDeleted" DataType="Boolean" Description="是否删除" />
      </Columns>
      <Indexes>
        <Index Columns="Type" />
        <Index Columns="CategoryId" />
        <Index Columns="Importance" />
        <Index Columns="CreatedAt" />
      </Indexes>
    </Table>
    <Table Name="MemoryCategory" Description="记忆分类">
      <Columns>
        <Column Name="Id" DataType="Int64" Identity="True" PrimaryKey="True" Description="分类ID" />
        <Column Name="Name" DataType="String" Master="True" Length="100" Nullable="False" Description="名称" />
        <Column Name="Description" DataType="String" Length="500" Description="描述" />
        <Column Name="Icon" DataType="String" Description="图标" />
        <Column Name="SortOrder" DataType="Int32" Description="排序" />
        <Column Name="MemoryCount" DataType="Int32" Description="记忆数量" />
        <Column Name="CreatedAt" DataType="DateTime" Description="创建时间" />
        <Column Name="UpdatedAt" DataType="DateTime" Description="更新时间" />
      </Columns>
    </Table>
  </Tables>
</EntityModel>