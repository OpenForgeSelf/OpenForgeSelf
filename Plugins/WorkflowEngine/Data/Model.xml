<?xml version="1.0" encoding="utf-8"?>
<EntityModel xmlns:xs="http://www.w3.org/2001/XMLSchema" xs:schemaLocation="https://newlifex.com https://newlifex.com/Model202509.xsd" ModelVersion="2.0.2026.130" Document="https://newlifex.com/xcode/model" xmlns="https://newlifex.com/Model202509.xsd">
  <Option>
    <!--类名模板。其中{name}替换为Table.Name，如{name}Model/I{name}Dto等-->
    <ClassNameTemplate>{name}</ClassNameTemplate>
    <!--显示名模板。其中{displayName}替换为Table.DisplayName-->
    <DisplayNameTemplate>{name}</DisplayNameTemplate>
    <!--基类。可能包含基类和接口，其中{name}替换为Table.Name-->
    <BaseClass>Entity</BaseClass>
    <!--命名空间-->
    <Namespace>ForgeSelf.Api.Plugins.WorkflowEngine.Entities</Namespace>
    <!--引用命名空间-->
    <ExtendNameSpace />
    <!--输出目录-->
    <Output>Entities</Output>
    <!--是否使用中文文件名。默认false-->
    <ChineseFileName>False</ChineseFileName>
    <!--用于生成Copy函数的参数类型。例如{name}或I{name}-->
    <ModelNameForCopy />
    <!--带有索引器。实现IModel接口-->
    <HasIModel>False</HasIModel>
    <!--可为null上下文。生成String?等-->
    <Nullable>False</Nullable>
    <!--数据库连接名-->
    <ConnName>WorkflowEngine</ConnName>
    <!--模型类模版。设置后生成模型类，用于接口数据传输，例如{name}Model-->
    <ModelClass />
    <!--模型类输出目录。默认当前目录的Models子目录-->
    <ModelsOutput>.\Models\</ModelsOutput>
    <!--模型接口模版。设置后生成模型接口，用于约束模型类和实体类，例如I{name}-->
    <ModelInterface />
    <!--模型接口输出目录。默认当前目录的Interfaces子目录-->
    <InterfacesOutput>.\Interfaces\</InterfacesOutput>
    <!--用户实体转为模型类的模型类。例如{name}或{name}DTO-->
    <ModelNameForToModel />
    <!--命名格式。Default/Upper/Lower/Underline-->
    <NameFormat>Default</NameFormat>
    <!--魔方区域显示名-->
    <DisplayName />
    <!--魔方控制器输出目录-->
    <CubeOutput />
  </Option>
  <Tables>
    <Table Name="WorkflowDefinition" Description="工作流定义">
      <Columns>
        <Column Name="Id" DataType="Int64" Identity="True" PrimaryKey="True" Description="工作流ID" />
        <Column Name="Name" DataType="String" Master="True" Length="200" Nullable="False" Description="名称" />
        <Column Name="Description" DataType="String" Length="1000" Description="描述" />
        <Column Name="Category" DataType="String" Length="100" Description="分类" />
        <Column Name="Icon" DataType="String" Length="500" Description="图标" />
        <Column Name="StepsJson" DataType="String" Length="8000" Description="步骤JSON" />
        <Column Name="VariablesJson" DataType="String" Length="4000" Description="变量JSON" />
        <Column Name="CreatedAt" DataType="DateTime" Description="创建时间" />
        <Column Name="UpdatedAt" DataType="DateTime" Description="更新时间" />
        <Column Name="IsFavorite" DataType="Boolean" Description="是否收藏" />
        <Column Name="UsageCount" DataType="Int32" Description="使用次数" />
        <Column Name="Status" DataType="Int32" Description="状态" />
        <Column Name="StartStepId" DataType="String" Length="100" Description="开始步骤ID" />
        <Column Name="MetadataJson" DataType="String" Length="2000" Description="元数据JSON" />
      </Columns>
      <Indexes>
        <Index Columns="Category" />
        <Index Columns="Status" />
      </Indexes>
    </Table>
    <Table Name="WorkflowExecution" Description="工作流执行记录">
      <Columns>
        <Column Name="Id" DataType="Int64" Identity="True" PrimaryKey="True" Description="执行ID" />
        <Column Name="WorkflowId" DataType="Int64" Description="工作流ID" />
        <Column Name="WorkflowName" DataType="String" Length="200" Description="工作流名称" />
        <Column Name="Status" DataType="Int32" Description="状态" />
        <Column Name="StartTime" DataType="DateTime" Description="开始时间" />
        <Column Name="EndTime" DataType="DateTime" Description="结束时间" />
        <Column Name="CurrentStepId" DataType="String" Length="100" Description="当前步骤ID" />
        <Column Name="LogsJson" DataType="String" Length="8000" Description="日志JSON" />
        <Column Name="ResultsJson" DataType="String" Length="4000" Description="结果JSON" />
        <Column Name="ErrorMessage" DataType="String" Length="2000" Description="错误信息" />
        <Column Name="VariablesJson" DataType="String" Length="4000" Description="变量JSON" />
        <Column Name="StepResultsJson" DataType="String" Length="8000" Description="步骤结果JSON" />
        <Column Name="Progress" DataType="Double" Description="进度" />
        <Column Name="TriggeredBy" DataType="String" Length="200" Description="触发者" />
      </Columns>
      <Indexes>
        <Index Columns="WorkflowId" />
        <Index Columns="Status" />
        <Index Columns="StartTime" />
      </Indexes>
    </Table>
  </Tables>
</EntityModel>