#!/bin/sh
# OpenForgeSelf pre-commit hook: AI-Native Pilot 工件链门禁（自动暴露，不依赖自觉）
#
# 规则：本次提交若触碰 docs/ai/pilot/<task>/ 下任何文件，则校验该任务目录的工件链是否齐全；
#       缺失/缺位 → 提交被拒绝。
# 引擎：优先 pwsh（PowerShell 7）；仅在找不到 pwsh 时回退 powershell.exe（5.1）并告警。
#       5.1 的 GBK 码页/无 Cert: 提供程序等问题见 AGENTS.md §7 与规则库 §B6。
# 安装：scripts/install-git-hooks.ps1（幂等，新 clone / 新环境第一步执行）
# 校验逻辑本体：scripts/verify-pilot-artifacts.ps1
# “非文档改动必须有工件”的 trailer 校验在 scripts/hooks/commit-msg。

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1

# 选择 PowerShell 引擎
if command -v pwsh >/dev/null 2>&1; then
  PS=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then
  PS=powershell.exe
  echo "[pre-commit] 警告：未找到 pwsh，回退 powershell.exe（5.1）。编码/签名类问题见规则库 §B6。"
else
  echo "[pre-commit] 警告：未找到 pwsh / powershell.exe，本机无法机械校验工件链，跳过门禁。"
  echo "[pre-commit] 请安装 PowerShell 7 后重跑 scripts/install-git-hooks.ps1。"
  exit 0
fi

# 本次提交（暂存区）触碰的 PILOT 任务目录集合（去重）
DIRS=$(git diff --cached --name-only --diff-filter=ACMR \
  | sed -n 's#^docs/ai/pilot/\([^/]*\)/.*#\1#p' \
  | sort -u)

FAIL=0

# 设计规范守卫（DESIGN.md 门禁三步第 1 步，2026-10-11 用户输入3 立）：
# 提交触及前端源码（宿主 ForgeSelf.Web/src 或插件 web/src）时，必跑
# check-style-tokens.mjs（禁新增裸色值）+ check-design-compliance.mjs（禁新增
# token 族违规/胶囊按钮/玻璃过头/蓝紫渐变），违反即拒绝提交——不许靠自觉。
STYLED=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(ForgeSelf\.Web/src|Plugins/[^/]+/web/src)/' || true)
if [ -n "$STYLED" ]; then
  echo "[pre-commit] 校验设计规范守卫 (design:check)"
  # 棘轮基线同步（task-14，2026-11-05）：worktree 的基线文件可能落后 main（分支点旧）
  # → 拦截口径漂移（11-04 夜 db-dev 9 色违规在 wt-db 漏拦、合 main 才拦）。
  # 规则：分支自身自 merge-base 起改过基线（合法棘轮抬升/-Update）或本次暂存改基线
  # → 尊重分支版本；否则临时取 main 侧基线校验本次提交，校验后恢复工作区文件
  # （只动工作区、不进暂存区，提交内容不变）。main 不可用时跳过（保持旧行为）。
  BASE_SHA=$(git merge-base HEAD main 2>/dev/null || git merge-base HEAD origin/main 2>/dev/null)
  MAIN_REF=""
  if git rev-parse --verify -q main >/dev/null 2>&1; then
    MAIN_REF=main
  elif git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    MAIN_REF=origin/main
  fi
  RESTORE_BASELINES=""
  if [ -n "$MAIN_REF" ] && [ -n "$BASE_SHA" ]; then
    for BLF in scripts/design-compliance-baseline.json scripts/style-token-baseline.json; do
      if [ -f "$BLF" ] \
         && [ -z "$(git diff --name-only "$BASE_SHA" HEAD -- "$BLF")" ] \
         && [ -z "$(git diff --name-only --cached -- "$BLF")" ]; then
        if git show "$MAIN_REF:$BLF" > "$BLF" 2>/dev/null; then
          RESTORE_BASELINES="$RESTORE_BASELINES $BLF"
        fi
      fi
    done
    if [ -n "$RESTORE_BASELINES" ]; then
      echo "[pre-commit] 棘轮基线按 $MAIN_REF 同步校验（分支基线未改动；校验后恢复）"
    fi
  fi
  (cd ForgeSelf.Web && node ../scripts/check-style-tokens.mjs && node ../scripts/check-design-compliance.mjs)
  GATE_RC=$?
  if [ -n "$RESTORE_BASELINES" ]; then
    git checkout -- $RESTORE_BASELINES 2>/dev/null || true
  fi
  if [ $GATE_RC -ne 0 ]; then
    echo "[pre-commit] 设计规范守卫 FAIL：存在新增硬编码色值 / 设计规范违反（DESIGN.md 门禁），提交已拒绝。"
    FAIL=1
  fi
fi

# 问题类台账扫描（G3 签名扫描，2026-10-17 problem-class-closure 机制）：
# 提交触碰台账/知识库（docs/11-troubleshooting/）或扫描器自身时，必跑一次全量
# signature 扫描（含 allowlist 到期日/守卫路径有效性）——台账改动不自检即腐烂。
PCS=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(docs/11-troubleshooting/|scripts/check-problem-classes\.ps1)' || true)
if [ -n "$PCS" ]; then
  echo "[pre-commit] 校验问题类台账 (check-problem-classes)"
  "$PS" -NoProfile -ExecutionPolicy Bypass -File "scripts/check-problem-classes.ps1"
  if [ $? -ne 0 ]; then
    echo "[pre-commit] 问题类台账扫描 FAIL：签名命中未豁免或台账不完整，提交已拒绝（见上方命中表）。"
    FAIL=1
  fi
fi

if [ -z "$DIRS" ]; then
  if [ $FAIL -ne 0 ]; then
    exit 1
  fi
  exit 0
fi
for d in $DIRS; do
  echo "[pre-commit] 校验 PILOT 工件链: $d"
  "$PS" -NoProfile -ExecutionPolicy Bypass \
    -File "scripts/verify-pilot-artifacts.ps1" -TaskId "$d" -EnforceHeader -EnforceAcCoverage -EnforceInteraction
  if [ $? -ne 0 ]; then
    FAIL=1
  fi
  # 问题类闭环门禁（v1.2.0，2026-10-17）：缺陷类任务（task_kind: defect 且目录日期 ≥2026-10-17）
  # 的 07 必含「问题类归档/重构提案/悬空教训」三节，缺任一拒绝提交；其余任务脚本内自动跳过。
  "$PS" -NoProfile -ExecutionPolicy Bypass \
    -File "scripts/check-problem-classes.ps1" -PilotTask "$d"
  if [ $? -ne 0 ]; then
    FAIL=1
  fi
done

if [ $FAIL -ne 0 ]; then
  echo ""
  echo "[pre-commit] PILOT 工件链门禁 FAIL：docs/ai/pilot/$DIRS 的必备文档缺失或不完整，提交已拒绝。"
  echo "[pre-commit] 补齐 docs/ai/pilot/<task>/ 工件（全量 00-07；轻量用 mini-task.md + 05/06/07）后重试。"
  exit 1
fi

exit 0
